{
  "name": "@froglylabs/orderly-plugin",
  "version": "0.1.2",
  "description": "Frogly for Orderly: adds Frogly's pinned script to a DEX once, with the DEX's own site ID. Keep your DEX safe from AI attacks: when an automated intruder takes one of Frogly's hidden decoys, Frogly records it.",
  "license": "MIT",
  "author": "Frogly",
  "homepage": "https://frogly.ai/orderly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/froglylabs/frogly-orderly.git"
  },
  "bugs": {
    "url": "https://github.com/froglylabs/frogly-orderly/issues"
  },
  "keywords": [
    "orderly",
    "orderly-plugin",
    "dex",
    "frogly",
    "decoys",
    "bot-detection",
    "security"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "configSchema.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:core": "node scripts/verify-core.mjs",
    "check:live": "node scripts/check-live-imports.mjs",
    "covers": "node scripts/build-covers.mjs",
    "e2e": "node scripts/e2e.mjs",
    "release:check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:core && pnpm check:live && orderly-devkit check --path . --strict && orderly-devkit schema --path . --check"
  },
  "peerDependencies": {
    "@orderly.network/hooks": ">=3.0.0",
    "@orderly.network/plugin-core": ">=3.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@orderly.network/hooks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orderly.network/devkit": "1.4.1",
    "@orderly.network/plugin-core": "3.4.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "31.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
